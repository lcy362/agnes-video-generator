# ═══════════════════════════════════════════════════════════════════
# Agnes Video Generator 配置模板（示例文件，绝不要放入真实 Key！）
#
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入你自己的 Key（从 https://platform.agnes-ai.com 获取，免费）
#   3. 重启服务生效（需已安装 python-dotenv；未安装时跳过 .env 读取，
#      Key 仍可通过环境变量或 Web 设置页 POST /api/config/keys 配置）
#
# 说明：
#   - 系统环境变量优先级高于 .env（同名时覆盖 .env 中的值）
#   - 注释掉（以 # 开头）的项表示「使用代码内默认值」，无需取消注释
#   - 完整部署方式见 docs/public/getting-started.md
# ═══════════════════════════════════════════════════════════════════


# ── 1. API Key（必填）──────────────────────────────────────────────
# 从 https://platform.agnes-ai.com 获取免费 Key
# ⚠️ 主 Key 的变量名不带序号（就是 AGNES_API_KEY，没有 AGNES_API_KEY_1 这个槽位）
AGNES_API_KEY=your-api-key-here


# ── 2. 多 Key 轮询（可选，推荐）────────────────────────────────────
# 每个 Key 的配额独立，总量 ≈ 20 × Key 数 / 分钟。
# 命名规则：主 Key 用 AGNES_API_KEY，额外 Key 从 AGNES_API_KEY_2 起序号依次递增
# （_2、_3、_4 ...），中间不可断号（断号之后的 Key 不会被加载）。
# 遇到 429 会自动轮换到下一个 Key；限速配额与并发上限随 Key 数线性放大。
# AGNES_API_KEY_2=your-second-api-key
# AGNES_API_KEY_3=your-third-api-key
# AGNES_API_KEY_4=your-fourth-api-key
# AGNES_API_KEY_5=your-fifth-api-key


# ── 3. 本地服务监听地址（非 Agnes API 地址）─────────────────────────
HOST=0.0.0.0
PORT=8765

# 注：Agnes API 走哪个站点（国际站 / 国内站）**不通过环境变量配置**
# （AGNES_BASE_URL 已废弃，代码中不再读取）。请在 Web 设置页的 API Key 面板
# 选择域名，或用「自动探测域名」逐 Key 补全匹配域名（每个 Key 可绑定各自域名）。
# 可选域名：com = apihub.agnes-ai.com（国际站）、cn = api.agnes-ai.cn（国内站，
# 需国内站专属 Key）、cn_bak = apihub.agnes-ai.cn（备用，国际站 Key 亦可用）。
# 跨站使用 Key 会得到 HTTP 401 / 无效的令牌。


# ── 4. 限速（可选）─────────────────────────────────────────────────
# 共享桶：Chat / 图片生成 / 图片上传 / 结果轮询 共用
# 默认 = 20 × Key 数 × 0.8 安全系数；仍频繁 429 时可适当调低
# AGNES_RATE_LIMIT=160

# 共享桶容量（默认 = 4 × Key 数；仅需调节突发并发时使用）
# AGNES_RATE_BURST=32

# 视频提交独立桶（默认 = 1 × Key 数）
# 若服务端对视频提交是「全局限 1/min」而非 per-Key，显式设为 1
# AGNES_VIDEO_RATE_LIMIT=8
# AGNES_VIDEO_RATE_BURST=8

# ⚠️ 与并发的联动：任务并发权重上限 = AGNES_RATE_LIMIT // 2（默认 10）
#    各任务类型权重：简单视频 1 / 创意视频 3 / 稿件视频 4 / 数字人 2 / 诗词 3
#    若把 AGNES_RATE_LIMIT 调得过低（例如 6），并发上限降到 3，
#    权重为 4 的稿件类任务会因「权重超过并发上限」而无法启动。
#    此时请调高该值，或配置多个 API Key。


# ── 5. 图生图模型（可选）───────────────────────────────────────────
# i2i 默认与 t2i 同模型（当前默认 agnes-image-2.5-flash）；如需为 i2i 固定旧版：
# AGNES_IMAGE_I2I_MODEL=agnes-image-2.1-flash
# （真实模型 ID 形如 agnes-image-2.5-flash / agnes-image-2.1-flash /
#   agnes-image-2.0-flash，不带 -flash 后缀的写法无效）
#
# 注：视频 / 图片主模型请通过 Web UI 或 POST /api/config 选择，
#     不再通过环境变量配置（AGNES_VIDEO_MODEL、AGNES_IMAGE_MODEL、
#     AGNES_BASE_URL 均已废弃，代码中不再读取）。


# ── 6. 运维（可选）─────────────────────────────────────────────────
# 启动时清理 N 天前的僵尸任务目录（不设置则不执行清理）
# AGNES_SWEEP_AGE_DAYS=7

# 多 Key 管理接口生成 Key id 所用的哈希盐，一般无需修改
# AGNES_CONFIG_ID_HMAC_KEY=agnes-config-keys-id-v1

# 视频任务轮询总超时（秒，默认 1800）
# AGNES_VIDEO_POLL_TIMEOUT=1800

# 字幕合成：=0 关闭 ffmpeg ASS 单链（回退 moviepy 词级动效路径），默认开启
# AGNES_SUBTITLE_ASS=1

# 提示词语言（zh/en，影响 LLM meta-prompt 语言）
# PROMPT_LANGUAGE=zh


# ── 7. CORS 跨源白名单（可选，供独立本地伴侣工具调用本服务 API）──────────
# 场景：本地跑一个独立的简化前端（如 agnes-simple-ui，监听 :8787），
# 从浏览器直接调用本服务的 /api/* 接口。设置后服务仅允许列出的源跨源调用。
# 默认空 = 不启用 CORS（攻击面不变）；同源页面不受影响。
# AGNES_CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:3000
#
# 显式禁用（即使设置了 origins 也不启用中间件）：
# AGNES_CORS_ENABLED=false
